# Normalise line endings for text files; keep binaries untouched.
* text=auto eol=lf

*.md      text diff=markdown
*.py      text eol=lf diff=python
*.kt      text eol=lf
*.kts     text eol=lf
*.json    text eol=lf
*.txt     text eol=lf
*.xml     text eol=lf
*.toml    text eol=lf
*.csv     text eol=lf

*.apk     binary
*.dex     binary
*.so      binary
*.arsc    binary
*.png     binary
*.webp    binary

# Windows launcher needs CRLF.
gradlew.bat text eol=crlf
